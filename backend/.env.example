# ---- Required ---------------------------------------------------------------
# MongoDB connection string (Atlas "mongodb+srv://..." or local "mongodb://127.0.0.1:27017").
# `npm run dev:local` ignores this and starts a private local mongod instead.
MONGODB_URI=mongodb://127.0.0.1:27017

# Secret used to sign login sessions (JWT). Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Optional in development (a random one is generated per run, logging everyone out on restart);
# required when NODE_ENV=production.
JWT_SECRET=replace_with_a_long_random_secret

# ---- Market data (Finnhub, free plan) --------------------------------------
# Backend-only key from https://finnhub.io/dashboard. Never put it in a VITE_* variable.
# Leave empty to run with clearly labelled sample prices instead of market data.
FINNHUB_API_KEY=your_finnhub_api_key_here
# Optional: "finnhub" or "demo" (default: finnhub when a key is set, otherwise demo).
# MARKET_DATA_PROVIDER=finnhub
# Optional: REST budget per minute (free plan allows 60; default 50 leaves headroom).
# FINNHUB_REST_CALLS_PER_MINUTE=50
# Optional: Finnhub allows ONE WebSocket per key. Set to "off" on a second instance (REST polling only).
# FINNHUB_STREAM=on

# ---- Optional ---------------------------------------------------------------
# PORT=3002
# Database name inside the cluster (default: zerodha_clone).
# MONGODB_DB_NAME=zerodha_clone
# Comma-separated browser origins allowed to call the API with cookies.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# JWT_EXPIRES_IN=1d
# Virtual cash given to new accounts (USD).
# STARTING_CASH=100000
# Login/signup attempts per IP per 15 minutes, and API requests per IP per minute.
# AUTH_RATE_LIMIT=20
# API_RATE_LIMIT=600
# NODE_ENV=development
